#41628=IFCPROPERTYSINGLEVALUE('Modifications',$,IFCLABEL('Cloison vitr\X2\00E9\X0\e et porte avec bandeau acoustique ferm\X2\00E9\X0\ jusqu\X2\201900E0\X0\ z=3,30 m entre Space 03/01; accueil longitudinal; suppression mobilier g\X2\00EA\X0\nant Space 02 et relogement des niches courbes V5 en rayonnages droits au nord et au fond ouest; fa\X2\00E7\X0\ade de proposition segment\X2\00E9\X0\e avec ouvertures rectangulaires, sans modifier les murs lat\X2\00E9\X0\raux; intentions de lumi\X2\00E8\X0\re lin\X2\00E9\X0\aire.'),$);
